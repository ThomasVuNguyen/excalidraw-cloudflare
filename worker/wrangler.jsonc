{
  "name": "excalidash-worker",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",

  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/health", "/csrf-token", "/auth/*", "/drawings/*", "/collections/*", "/library/*", "/system/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "excalidash-db",
      "database_id": "e263c9e9-0d02-41e9-9113-2218c87ba36e",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "excalidash-storage"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "4307512814534b69a9ef37a04522f4ca"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "DRAWING_ROOM",
        "class_name": "DrawingRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DrawingRoom"]
    }
  ],

  "vars": {
    "AUTH_MODE": "local",
    "FRONTEND_URL": "https://draw.beenex.company"
  },

  "routes": [
    {
      "pattern": "draw.beenex.company",
      "custom_domain": true
    },
    {
      "pattern": "api.draw.beenex.company",
      "custom_domain": true
    }
  ],

  "workers_dev": true,

  "placement": {
    "mode": "smart"
  },

  "limits": {
    "cpu_ms": 30000
  }
}
